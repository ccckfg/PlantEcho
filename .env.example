# PlantEcho 1.0.0
# Local development: copy to .env
# Docker Compose deployment: copy application settings to dyn.env.
# Compose-only settings are read from the shell or a root .env file.

# Compose-only deployment settings
DYN_IMAGE=ccckfg/dyn:1.0.0
HTTP_PUBLIC_PORT=8787
MQTT_PUBLIC_PORT=1883
DYN_DATA_PATH=./data
TZ=Asia/Shanghai

# Server
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
DYN_DATA_DIR=data
DB_PROVIDER=postgres
DATABASE_URL=postgresql://dyn:dyn-local-password@127.0.0.1:5432/dyn
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Operational history retention
RETENTION_CLEANUP_INTERVAL_MS=86400000
RETENTION_SENSOR_RAW_DAYS=30
RETENTION_SYNC_EVENTS_DAYS=14
RETENTION_SUCCEEDED_JOBS_DAYS=14
RETENTION_CONSUMED_DRAFTS_DAYS=30
RETENTION_LLM_USAGE_DAYS=180
RETENTION_PROACTIVE_EVENTS_DAYS=90
RETENTION_PROACTIVE_DECISIONS_DAYS=180
RETENTION_FINISHED_REMINDERS_DAYS=180
RETENTION_AUTH_SESSIONS_DAYS=180
RETENTION_PENDING_DEVICES_DAYS=30

# MQTT and device configuration delivery
MQTT_ENABLED=true
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
DEVICE_CONFIG_RETRY_INTERVAL_MS=5000
DEFAULT_PLANT_ID=plant-demo
DEFAULT_DEVICE_ID=esp32-demo

# Authentication
# Generate a strong random AUTH_TOKEN_SECRET before production deployment.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=168
AUTH_REGISTRATION_ENABLED=true
# Legacy compatibility only. Leave empty for new deployments.
APP_ACCESS_KEY=

# Required primary OpenAI-compatible LLM
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TEMPERATURE=0.7
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Optional secondary model for structured background tasks.
# Empty URL/key reuse the primary provider; empty model uses the primary model.
SECONDARY_LLM_API_URL=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL_ID=
SECONDARY_LLM_TEMPERATURE=0.2
SECONDARY_LLM_INPUT_COST_PER_MILLION=0
SECONDARY_LLM_OUTPUT_COST_PER_MILLION=0

# Embedding is required for plant chat; rerank is optional.
# Empty embedding URL/key reuse the primary provider.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL_ID=

# QWeather
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_DEFAULT_LOCATION=101200113
QWEATHER_CACHE_TTL_SECONDS=600
# Legacy weather variable compatibility
WeatherKey=
WeatherUrl=
WeatherLocation=

# Proactive speech engine
PROACTIVE_ENABLED=true
PROACTIVE_LLM_ENABLED=true
PROACTIVE_SCAN_INTERVAL_MS=300000
PROACTIVE_REMINDER_MAX_DAYS=30
PROACTIVE_STARTUP_DELAY_MS=90000
PROACTIVE_DEFAULT_TIMEZONE=Asia/Shanghai
PROACTIVE_QUIET_START=22:30
PROACTIVE_QUIET_END=08:00
PROACTIVE_USER_PRESENCE_WINDOW_MS=1800000
PROACTIVE_VISIBLE_HEARTBEAT_TTL_MS=90000
PROACTIVE_INTENTION_CLAIM_MS=600000
PROACTIVE_KEEP_BASE_COOLDOWN_MS=86400000
PROACTIVE_KEEP_MAX_COOLDOWN_MS=345600000
PROACTIVE_INTENTION_FAILURE_RETRY_BASE_MS=1800000
PROACTIVE_INTENTION_FAILURE_RETRY_MAX_MS=43200000
PROACTIVE_REMINDER_CLAIM_LEASE_MS=600000
PROACTIVE_REMINDER_LATE_NARRATIVE_MS=7200000
PROACTIVE_REMINDER_EXPIRE_AFTER_MS=86400000
PROACTIVE_AWAY_RETRY_MS=900000
PROACTIVE_BUDGET_RETRY_MS=3600000
PROACTIVE_BUDGET_REFILL_WINDOW_MS=86400000
PROACTIVE_DEFAULT_TALKATIVENESS=moderate
PROACTIVE_BUDGET_QUIET_CAPACITY=1
PROACTIVE_BUDGET_MODERATE_CAPACITY=2
PROACTIVE_BUDGET_ACTIVE_CAPACITY=4
PROACTIVE_BODY_EWMA_ALPHA=0.25
PROACTIVE_BODY_PERSISTENCE_MS=43200000
PROACTIVE_BODY_MAX_GAP_MS=1800000
PROACTIVE_BODY_INTENTION_EXPIRY_MS=172800000
PROACTIVE_SILENCE_WARM_DAYS=3
PROACTIVE_SILENCE_COOL_DAYS=7
PROACTIVE_SILENCE_INTENTION_EXPIRY_MS=2592000000
PROACTIVE_ANNIVERSARY_INTENTION_EXPIRY_MS=172800000
PROACTIVE_MORNING_GREETING_ENABLED=false
PROACTIVE_MORNING_START=07:30
PROACTIVE_MORNING_END=09:30
