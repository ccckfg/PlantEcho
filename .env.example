# Server
PORT=8787
HOST=0.0.0.0
DYN_DATA_DIR=apps/server/data
MQTT_ENABLED=true
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
DEFAULT_PLANT_ID=plant-demo
DEFAULT_DEVICE_ID=esp32-demo
APP_ACCESS_KEY=

# Required for plant chat: OpenAI-compatible LLM
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TEMPERATURE=0.7
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Optional secondary model for simple structured tasks. If omitted, tasks use the primary model.
# URL/key may be empty to reuse the primary provider.
SECONDARY_LLM_API_URL=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL_ID=
SECONDARY_LLM_TEMPERATURE=0.2
SECONDARY_LLM_INPUT_COST_PER_MILLION=0
SECONDARY_LLM_OUTPUT_COST_PER_MILLION=0

# Embedding is required for plant chat; rerank remains optional.
# If EMBEDDING_API_URL / EMBEDDING_API_KEY are empty, LLM_API_URL / LLM_API_KEY are reused.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL_ID=

# Optional QWeather / 和风天气 API Key mode
# WeatherKey / WeatherUrl are supported for compatibility.
WeatherKey=
WeatherUrl=
WeatherLocation=101200113
QWEATHER_CACHE_TTL_SECONDS=600

# Proactive speech engine
PROACTIVE_ENABLED=true
PROACTIVE_LLM_ENABLED=true
PROACTIVE_SCAN_INTERVAL_MS=300000
PROACTIVE_WEATHER_ENABLED=false
PROACTIVE_WEATHER_SCAN_INTERVAL_MS=3600000
PROACTIVE_WEATHER_COOLDOWN_MS=21600000
PROACTIVE_REMINDER_MAX_DAYS=30
